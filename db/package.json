{
  "name": "@domesday/db",
  "version": "0.0.0",
  "private": true,
  "description": "Numbered PostgreSQL 16 migrations, a small migration runner, and tests for tenant isolation.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx src/cli.ts up",
    "migrate:down": "tsx src/cli.ts down",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@domesday/domain": "workspace:*",
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
