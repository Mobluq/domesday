{
  "name": "@domesday/web",
  "version": "0.0.0",
  "private": true,
  "description": "Domesday web app: walks, phone capture, review, comparison, reconciliation and reports. Runs on the claude.ai artifact runtime for the demo, or locally with an in-browser store.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:artifact": "DOMESDAY_ARTIFACT=1 vite build && node scripts/artifact.mjs",
    "preview": "vite preview",
    "media": "python3 scripts/make_media.py",
    "seed": "node scripts/make-seed.mjs",
    "e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@domesday/domain": "workspace:*",
    "@domesday/tokens": "workspace:*",
    "@noble/hashes": "1.8.0",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "ioredis": "5.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
