    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@domesday/db": "workspace:*",
    "@electric-sql/pglite": "^0.5.15",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3",
